#!/usr/bin/env bash
#
# Extract an archive with unar (no tarbombs), then trash it and any split-zip
# volumes. -t/--touch resets extracted mtimes to now.

set -euo pipefail

touch=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    -t|--touch) touch=true; shift ;;
    --) shift; break ;;
    -*) echo "extract: unknown option '$1'" >&2; exit 1 ;;
    *) break ;;
  esac
done

file=${1:?usage: extract [-t|--touch] ARCHIVE}
[ -f "$file" ] || { echo "extract: '$file' is not a file" >&2; exit 1; }
assert_installed unar

# unar's last line names what it created.
out=$(unar -r -- "$file" | tee /dev/stderr)
target=$(sed -n 's/^Successfully extracted to "\(.*\)"\.$/\1/p' <<<"$out")

if [ "$touch" = true ]; then
  [ -e "$target" ] || { echo "extract: can't find extracted '$target' to touch" >&2; exit 1; }
  find "./$target" -exec touch {} +
  echo "extract: reset timestamps of './$target' to now"
fi

# Split-zip volumes: name.z01, name.z02, ...
originals=("$file")
if [[ $file == *.zip ]]; then
  for ((i = 1; ; i++)); do
    part=$(printf '%s.z%02d' "${file%.zip}" "$i")
    [ -f "$part" ] || break
    originals+=("$part")
  done
fi

if command -v trash-put >/dev/null 2>&1; then
  trash-put -- "${originals[@]}" && echo "extract: moved ${originals[*]@Q} to trash"
else
  printf "extract: delete %s? [y/N] " "${originals[*]@Q}" >&2
  read -r reply </dev/tty || reply=""
  case "$reply" in
    [yY]|[yY][eE][sS]) rm -f -- "${originals[@]}"; echo "extract: deleted ${originals[*]@Q}" ;;
    *) echo "extract: kept ${originals[*]@Q}" ;;
  esac
fi
